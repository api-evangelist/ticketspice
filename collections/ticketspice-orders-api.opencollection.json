{
  "opencollection": "1.0.0",
  "info": {
    "name": "TicketSpice API (Webconnex v2 Public) Coupons Orders API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.webconnex.com/v2/public/search/orders",
            "params": [
              {
                "name": "product",
                "value": "",
                "type": "query",
                "description": "Webconnex product to scope the request to. Use ticketspice for TicketSpice."
              },
              {
                "name": "formId",
                "value": "",
                "type": "query",
                "description": "Filter results to a single form (event page)."
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size. Default 50."
              },
              {
                "name": "startingAfter",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination - the id to start after."
              },
              {
                "name": "dateCreatedAfter",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateCreatedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query",
                "description": "Comma-separated related objects to expand (registrants, tickets, subscription, inventory)."
              }
            ]
          },
          "docs": "Search orders"
        },
        {
          "info": {
            "name": "View order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.webconnex.com/v2/public/search/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "product",
                "value": "",
                "type": "query",
                "description": "Webconnex product to scope the request to. Use ticketspice for TicketSpice."
              },
              {
                "name": "expand",
                "value": "",
                "type": "query",
                "description": "Comma-separated related objects to expand (registrants, tickets, subscription, inventory)."
              }
            ]
          },
          "docs": "View order"
        }
      ]
    }
  ],
  "bundled": true
}